<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the Info.plist Xcode generates from the INFOPLIST_KEY_*
	     build settings (GENERATE_INFOPLIST_FILE stays YES). Debug only: it is
	     wired up by Config/Debug.xcconfig, so the Release build never carries
	     it. $(API_BASE_URL) is expanded at build time and is empty unless
	     Config/Local.xcconfig sets it. -->
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>

	<!-- Lets the DEBUG build reach the dev API over plaintext HTTP on the
	     LAN. NSAllowsLocalNetworking is the narrow exception: it covers
	     *.local (mDNS) and unqualified hostnames only — NOT arbitrary hosts,
	     and NOT raw private IPs like 10.x or 192.168.x. That is why
	     Local.xcconfig should hold the Mac's .local name rather than its
	     current lease. Debug only, via the same wiring as APIBaseURL above,
	     so the Release build keeps ATS fully enforced. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
