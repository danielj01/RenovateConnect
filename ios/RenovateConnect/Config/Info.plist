<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the Info.plist Xcode generates from the INFOPLIST_KEY_*
	     build settings (GENERATE_INFOPLIST_FILE stays YES). Debug only: it is
	     wired up by Config/Debug.xcconfig, so the Release build never carries
	     it. $(API_BASE_URL) is expanded at build time and is empty unless
	     Config/Local.xcconfig sets it. -->
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
</dict>
</plist>
